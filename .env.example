# ==============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)
#  cp .env.example .env
# ==============================================================

# ---------- Discord ----------
DISCORD_TOKEN=ใส่_token_บอทของคุณที่นี่

# (ไม่บังคับ) ใส่ ID เซิร์ฟเวอร์ เพื่อให้ slash command ขึ้นทันทีในเซิร์ฟเวอร์นั้น
# ถ้าเว้นว่าง จะ sync แบบ global (อาจใช้เวลาสักพักกว่าจะขึ้น)
GUILD_ID=

# (ไม่บังคับ) ห้องคุยกับ AI: บอทตอบทุกข้อความในห้องเหล่านี้ ไม่ต้อง /ask หรือ mention
# ใส่ ID ช่อง คั่นด้วยจุลภาค หรือเว้นว่างแล้วใช้คำสั่ง /aichannel ใน Discord แทนก็ได้
AI_CHANNEL_IDS=

# (ไม่บังคับ) ห้อง log ของแอดมิน: แจ้งเมื่อสลับไปตัวสำรอง / AI ใช้ไม่ได้ / โมเดลถูกถอด + สรุปรายวัน
# ใส่ ID ช่อง หรือเว้นว่างแล้วใช้คำสั่ง /logchannel ในห้องที่ต้องการแทนก็ได้
LOG_CHANNEL_ID=

# ---------- เลือกผู้ให้บริการ AI ----------
# ค่าที่ใช้ได้: gemini | groq | openrouter
AI_PROVIDER=gemini

# ---------- ผู้ให้บริการสำรอง (ไม่บังคับ แต่แนะนำ) ----------
# ถ้าตัวหลักเกินโควต้า (429) / ล่ม (503) / ช้าเกิน จะตอบด้วยตัวสำรองแทนอัตโนมัติ
# ใส่ได้หลายเจ้า คั่นด้วยจุลภาค ลองตามลำดับ เช่น groq,openrouter
# เว้นว่าง = ใช้ทุกเจ้าที่กรอก API key + โมเดลไว้ด้านล่าง, none = ไม่ใช้ตัวสำรอง
BACKUP_PROVIDER=

# ---------- Google Gemini (ฟรี ไม่ต้องผูกบัตร) ----------
# ขอ key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
GEMINI_API_KEYS=
# ชื่อโมเดลเปลี่ยนบ่อย ตรวจชื่อล่าสุดได้ที่ https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
GEMINI_FALLBACK_MODELS=
# (ไม่บังคับ) โมเดลที่ใช้เมื่อคำถามมีรูป — ปกติ Gemini อ่านรูปได้อยู่แล้ว ไม่ต้องใส่
GEMINI_VISION_MODEL=

# ---------- Groq (ฟรี ไม่ต้องผูกบัตร) ----------
# ขอ key: https://console.groq.com/keys
GROQ_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
GROQ_API_KEYS=
# ดูรายชื่อโมเดล: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
GROQ_FALLBACK_MODELS=
# (ไม่บังคับ) โมเดลที่ใช้เมื่อคำถามมีรูป — ดูโมเดลที่รับรูปได้ในหน้ารายชื่อโมเดลของ Groq
GROQ_VISION_MODEL=

# ---------- OpenRouter (ใช้เฉพาะโมเดลที่ลงท้าย :free) ----------
# ขอ key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
OPENROUTER_API_KEYS=
# ดูโมเดลฟรี: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
OPENROUTER_FALLBACK_MODELS=
# (ไม่บังคับ) โมเดลที่ใช้เมื่อคำถามมีรูป — หาโมเดลฟรีที่รับรูปได้: https://openrouter.ai/models?max_price=0&input_modalities=image
OPENROUTER_VISION_MODEL=

# ---------- บุคลิกบอท ----------
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่เป็นมิตรในเซิร์ฟเวอร์ Discord ตอบกระชับ สุภาพ และตอบเป็นภาษาเดียวกับที่ผู้ใช้ถาม (ถ้าผู้ใช้พิมพ์ไทยให้ตอบไทย)

# ---------- การตั้งค่าอื่น ๆ ----------
# เขตเวลาที่บอกให้ AI รู้วันเวลาปัจจุบัน
TIMEZONE=Asia/Bangkok
# ให้ Gemini ค้น Google ได้เองเมื่อคำถามต้องใช้ข้อมูลล่าสุด (เฉพาะ Gemini; free tier มีโควต้าค้นเว็บจำกัด)
WEB_SEARCH=true
# (แนะนำ) ค้นเว็บผ่าน Tavily — ฟรีเดือนละ 1,000 ครั้ง ไม่ต้องผูกบัตร ขอ key: https://app.tavily.com
# ใส่แล้วบอทจะค้นเว็บเองเมื่อถามเรื่องข่าว/ราคา/ข้อมูลล่าสุด (ใช้ได้กับทุกผู้ให้บริการ AI)
# หรือพิมพ์ขึ้นต้นด้วย "ค้นหา" เพื่อบังคับค้นเว็บ
TAVILY_API_KEY=
# แสดงคำตอบค่อย ๆ พิมพ์ออกมาระหว่างที่ AI กำลังตอบ (false = ส่งทีเดียวตอนเสร็จ)
STREAMING=true
# แสดงบรรทัดเล็กใต้คำตอบ (เวลาที่ใช้ · โมเดล · แหล่งที่มาเมื่อค้นเว็บ)
SHOW_FOOTER=true
# จำบทสนทนาลงไฟล์ (DATA_DIR/bot.db) ไม่หายเมื่อรีสตาร์ท (false = จำใน RAM อย่างเดียว)
MEMORY_PERSIST=true
# จำนวนคำถามสูงสุดต่อคนต่อวัน (0 = ไม่จำกัด) — แอดมิน (Manage Server) ไม่ถูกจำกัด
DAILY_LIMIT_PER_USER=30
# จำนวนข้อความล่าสุดที่จำต่อช่อง (นับทั้งของผู้ใช้และของบอท)
MEMORY_SIZE=10
# จำนวนรูปสูงสุดที่ส่งให้ AI ต่อ 1 ข้อความ (0 = ปิดการอ่านรูป) และขนาดสูงสุดต่อรูป (MB)
# Groq / OpenRouter ต้องเลือกโมเดลที่รองรับรูป (vision) ถึงจะอ่านรูปได้
MAX_IMAGES=4
MAX_IMAGE_MB=5
# อ่านไฟล์ PDF / ข้อความ / โค้ดที่แนบมา: ขนาดสูงสุดต่อไฟล์ (MB) และจำนวนตัวอักษรสูงสุดที่ส่งให้ AI (0 = ปิด)
MAX_FILE_MB=10
MAX_FILE_CHARS=40000
# คำตอบยาวเกินกี่ตัวอักษรให้แนบเป็นไฟล์ .txt แทนการแตกเป็นหลายข้อความ (0 = ปิด)
LONG_ANSWER_FILE_CHARS=4000
# โหมดเธรด: ให้ AI ตั้งชื่อเธรดให้ตรงเรื่องหลังตอบคำถามแรก (ใช้คำขอ AI เพิ่ม 1 ครั้งต่อเธรด)
THREAD_AUTO_TITLE=true
# เวลารอ (วินาที) ระหว่างคำถามของผู้ใช้คนเดียวกัน
USER_COOLDOWN_SECONDS=10
# จำนวนครั้งที่ลองใหม่เมื่อเซิร์ฟเวอร์ AI ล่มชั่วคราว (HTTP 5xx) ก่อนสลับไปโมเดลสำรอง (0-5)
AI_MAX_RETRIES=2
# โฟลเดอร์เก็บข้อมูลของบอท (เช่น ห้องที่เปิดด้วย /aichannel)
DATA_DIR=data
# เวลารอคำตอบจาก AI สูงสุด (วินาที)
AI_TIMEOUT_SECONDS=60
# อุณหภูมิ (ความสร้างสรรค์) 0.0 - 2.0
AI_TEMPERATURE=0.7
