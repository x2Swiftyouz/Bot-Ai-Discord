# ==============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)
#  cp .env.example .env
# ==============================================================

# ---------- Discord ----------
DISCORD_TOKEN=ใส่_token_บอทของคุณที่นี่

# (ไม่บังคับ) ใส่ ID เซิร์ฟเวอร์ เพื่อให้ slash command ขึ้นทันทีในเซิร์ฟเวอร์นั้น
# ถ้าเว้นว่าง จะ sync แบบ global (อาจใช้เวลาสักพักกว่าจะขึ้น)
GUILD_ID=

# (ไม่บังคับ) ห้องคุยกับ AI: บอทตอบทุกข้อความในห้องเหล่านี้ ไม่ต้อง /ask หรือ mention
# ใส่ ID ช่อง คั่นด้วยจุลภาค หรือเว้นว่างแล้วใช้คำสั่ง /aichannel ใน Discord แทนก็ได้
AI_CHANNEL_IDS=

# ---------- เลือกผู้ให้บริการ AI ----------
# ค่าที่ใช้ได้: gemini | groq | openrouter
AI_PROVIDER=gemini

# ---------- ผู้ให้บริการสำรอง (ไม่บังคับ แต่แนะนำ) ----------
# ถ้าตัวหลักเกินโควต้า (429) / ล่ม (503) / ช้าเกิน จะตอบด้วยตัวนี้แทนอัตโนมัติ
# ค่าที่ใช้ได้: gemini | groq | openrouter | none
# เว้นว่าง = เลือกให้อัตโนมัติจากเจ้าที่กรอก API key + โมเดลไว้ด้านล่าง, none = ไม่ใช้ตัวสำรอง
BACKUP_PROVIDER=

# ---------- Google Gemini (ฟรี ไม่ต้องผูกบัตร) ----------
# ขอ key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
GEMINI_API_KEYS=
# ชื่อโมเดลเปลี่ยนบ่อย ตรวจชื่อล่าสุดได้ที่ https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
GEMINI_FALLBACK_MODELS=

# ---------- Groq (ฟรี ไม่ต้องผูกบัตร) ----------
# ขอ key: https://console.groq.com/keys
GROQ_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
GROQ_API_KEYS=
# ดูรายชื่อโมเดล: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
GROQ_FALLBACK_MODELS=

# ---------- OpenRouter (ใช้เฉพาะโมเดลที่ลงท้าย :free) ----------
# ขอ key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# (ไม่บังคับ) key เพิ่มเติม คั่นด้วยจุลภาค — key แรกเกินโควต้าจะสลับไปตัวถัดไปเอง (ควรเป็นคนละโปรเจกต์/บัญชี)
OPENROUTER_API_KEYS=
# ดูโมเดลฟรี: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# (ไม่บังคับ) โมเดลสำรอง — ใส่ "ชื่อโมเดล" คั่นด้วยจุลภาค (ไม่ใช่ API key) ใช้เมื่อโมเดลหลักล่ม/เกินโควต้า/ถูกถอด
OPENROUTER_FALLBACK_MODELS=

# ---------- บุคลิกบอท ----------
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่เป็นมิตรในเซิร์ฟเวอร์ Discord ตอบกระชับ สุภาพ และตอบเป็นภาษาเดียวกับที่ผู้ใช้ถาม (ถ้าผู้ใช้พิมพ์ไทยให้ตอบไทย)

# ---------- การตั้งค่าอื่น ๆ ----------
# เขตเวลาที่บอกให้ AI รู้วันเวลาปัจจุบัน
TIMEZONE=Asia/Bangkok
# ให้ Gemini ค้น Google ได้เองเมื่อคำถามต้องใช้ข้อมูลล่าสุด (เฉพาะ Gemini; free tier มีโควต้าค้นเว็บจำกัด)
WEB_SEARCH=true
# แสดงบรรทัดเล็กใต้คำตอบ (เวลาที่ใช้ · โมเดล · แหล่งที่มาเมื่อค้นเว็บ)
SHOW_FOOTER=true
# จำนวนข้อความล่าสุดที่จำต่อช่อง (นับทั้งของผู้ใช้และของบอท)
MEMORY_SIZE=10
# จำนวนรูปสูงสุดที่ส่งให้ AI ต่อ 1 ข้อความ (0 = ปิดการอ่านรูป) และขนาดสูงสุดต่อรูป (MB)
# Groq / OpenRouter ต้องเลือกโมเดลที่รองรับรูป (vision) ถึงจะอ่านรูปได้
MAX_IMAGES=4
MAX_IMAGE_MB=5
# เวลารอ (วินาที) ระหว่างคำถามของผู้ใช้คนเดียวกัน
USER_COOLDOWN_SECONDS=10
# จำนวนครั้งที่ลองใหม่เมื่อเซิร์ฟเวอร์ AI ล่มชั่วคราว (HTTP 5xx) ก่อนสลับไปโมเดลสำรอง (0-5)
AI_MAX_RETRIES=2
# โฟลเดอร์เก็บข้อมูลของบอท (เช่น ห้องที่เปิดด้วย /aichannel)
DATA_DIR=data
# เวลารอคำตอบจาก AI สูงสุด (วินาที)
AI_TIMEOUT_SECONDS=60
# อุณหภูมิ (ความสร้างสรรค์) 0.0 - 2.0
AI_TEMPERATURE=0.7
